# في الأول كان مطلوب مني أعمل كود بايثون لآلة حاسبة بسيطة
# بس أنا حبيت أعمله بطريقة مختلفة ومميزة عن العادي
# فكرت إني بعد ما المستخدم يخلص العملية الحسابية وتطلع النتيجة، لو داس حرف الـ C 
# تفتح له عملية جديدة من أول وجديد
# بصراحة في الأول ما كنتش عارفة أعمل الفكرة دي إزاي  
# بس لما سألت بشمهندس مصطفى،قالي إن الفكرة دي ممكن نعملها بكل سهولة باستخدام "الحلقات التكرارية" (Loops)
# روحت علطول عملت سيرش وبحثت عن الحلقات التكرارية وفهمت بتشتغل إزاي وطبقتها في الكود بتاعي
# وبعدين حبيت أطور الكود أكتر وأعمل له تحديث جديد :
#  بحيث انه لو المستخدم ضغط C يعيد له عمليه حسابيه تاني
# ولو المستخدم ضغط X يقفل له الآلة الحاسبة خالص ويطلع برا ويطبع له رسالة: Thank you. Goodbye
#
#
# بنعمل متغير اسمه y وبنديله قيمة مبدئية "c" عشان نخلي حلقة while ترضى تبدأ وتشتغل أول مرة
y = "c"

# حلقة تكرارية هتفضل تعيد الأسطر اللي تحتها طول ما قيمة y هي حرف الـ c (سواء صغير أو كبير)
while y == "c" or y == "C":
    
    # بنطلب من المستخدم يدخل الرقم الأول وبنحوله لـ float عشان يقبل الكسور ونخزنه في num1
    num1 = float(input(" enter number: "))
    
    # بنطلب من المستخدم يختار علامة العملية الحسابية وبنخزنها في متغير اسمه M
    M = input("Choose an operator (+, -, *, /): ")
    
    # بنطلب من المستخدم يدخل الرقم التاني وبنحوله لـ float برضه ونخزنه في num2
    num2 = float(input("Please enter the second number: "))

    # بنختبر لو قيمة المتغير M هي علامة الزائد (+)
    if M == "+":
        # لو الشرط صح، اجمع الرقمين واطبع الناتج ع الشاشة
        print("The answer is:", num1 + num2)
        
    # لو الشرط الأول لاء، بنشوف لو قيمة M هي علامة الناقص (-)
    elif M == "-":
        # لو صح، اطرح الرقم التاني من الأول واطبع الناتج
        print("The answer is:", num1 - num2)
        
    # لو الشروط اللي فوق لاء، بنشوف لو قيمة M هي علامة الفي (*)
    elif M == "*":
        # لو صح، اضرب الرقمين في بعض واطبع الناتج
        print("The answer is:", num1 * num2)
        
    # لو الشروط اللي فوق لاء، بنشوف لو قيمة M هي علامة العلى (/) بتاعة القسمة
    elif M == "/":
        # شرط داخلي مهم: بنلمح الرقم التاني للتأكد إنه مش بيساوي صفر عشان نمنع خطأ في السيستم
        if num2 != 0:
            # لو مش بصفر، اقسم الرقم الأول على التاني واطبع الناتج عادي
            print("The answer is:", num1 / num2)
        else:
            # لو الرقم التاني طلع صفر، اطبع رسالة تحذيرية للمستخدم إن القسمة على صفر غلط
            print("Error: Cannot divide by zero.")
            
    # الـ else دي بتشتغل لو المستخدم كتب أي رمز غريب مش موجود في العمليات الأربعة فوق
    else:
        # بنطبع رسالة نبهه إن العملية اللي اختارها مش صحيحة
        print("Invalid operator.")

    # بنسأل المستخدم لو عاوز يحسب تاني، وبناخد رده نخزنه في الـ y (لو كتب c الحلقة هتعيد، لو كتب x أو أي حاجة تانية الحلقة هتقف)
    y = input("Press 'C' to calculate again, or 'X' to exit: ")

# السطر ده بره الحلقة خالص، وهيشتغل بس لما المستخدم يقرر يخرج ويقفل البرنامج عشان يودعه
print("Thank you. Goodbye")